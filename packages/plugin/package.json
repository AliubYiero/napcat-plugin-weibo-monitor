{
    "name": "napcat-plugin-weibo-monitor",
    "plugin": "微博动态监听",
    "description": "按 UID 订阅微博博主，定时拉取新动态并渲染为长图推送到 QQ 群 / 私聊",
    "version": "1.0.0",
    "type": "module",
    "main": "index.mjs",
    "author": "Yiero",
    "license": "MIT",
    "keywords": [
        "napcat",
        "plugin",
        "qq",
        "weibo",
        "monitor"
    ],
    "napcat": {
        "tags": [
            "工具"
        ],
        "minVersion": "4.14.0",
        "homepage": "https://github.com/AliubYiero/napcat-plugin-weibo-monitor"
    },
    "dependencies": {
        "playwright-core": "^1.63.0"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@types/express": "^5.0.6",
        "@types/node": "^20.19.33",
        "napcat-plugin-debug-cli": "^1.2.8",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "vitest": "^4.0.18",
        "ws": "^8.19.0",
        "shared": "workspace:*",
        "webui": "workspace:*"
    },
    "scripts": {
        "build": "vite build",
        "deploy": "vite build --mode deploy",
        "deploy:dev": "vite build --mode deploy-dev",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "weibo:test": "tsx scripts/weiboTest/index.ts",
        "help:generate": "tsx scripts/generateHelp/index.ts"
    }
}
